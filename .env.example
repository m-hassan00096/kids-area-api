APP_NAME="Kids Area"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_EG
BUSINESS_TIMEZONE=Africa/Cairo

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kids_area_local
DB_USERNAME=kids_area_local
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=
# Configure exact same-site origins and only actual trusted reverse proxies.
IDENTITY_API_ORIGIN=
IDENTITY_FRONTEND_ORIGINS=
IDENTITY_TRUSTED_PROXIES=
# Optional matching synthetic hash if Argon2id work factors are changed.
IDENTITY_DUMMY_HASH=
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
MAIL_MAILER=log
